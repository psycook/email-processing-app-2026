{
  "schemaVersion": 1,
  "publisherPrefix": "rfd",
  "logicalMailboxKey": "help-inbox",
  "hashEncoding": "SHA-256 lowercase hex over each UTF-8 component preceded by a 4-byte unsigned big-endian byte count",
  "ingestKeyComponents": ["v1", "organizationId lowercase GUID D", "help-inbox", "InternetMessageId.Trim() (case and brackets preserved)"],
  "limits": { "requestJsonCharacters": 32768, "pageSize": 100, "processExecutions": 500, "processCases": 100, "observerFanOut": 50 },
  "processStates": ["received", "processing", "waiting-review", "completed", "failed", "cancelled", "needs-reconciliation"],
  "executionStates": ["running", "waiting", "succeeded", "failed", "skipped", "cancelled"],
  "eventTypes": ["received", "started", "waiting", "completed", "failed", "skipped", "cancelled", "case-linked", "case-resolved", "case-cancelled", "case-merged", "case-reopened", "case-reconciled"],
  "api": {
    "isFunction": false, "isPrivate": false, "allowedCustomProcessingStepType": 0,
    "input": { "name": "RequestJson", "type": "String" },
    "output": { "name": "ResponseJson", "type": "String" },
    "actions": ["rfd_RecordEmailProcessEvent", "rfd_LinkEmailProcessCase", "rfd_RecordCaseLifecycle", "rfd_GetEmailProcessState", "rfd_GetEmailProcessEvents", "rfd_ListEmailProcesses", "rfd_GetProcessDefinitions"]
  },
  "requestContract": {
    "documentation": "api-contract.txt",
    "jsonCasing": "camelCase",
    "schemaVersion": 1,
    "envelopeParameter": "RequestJson",
    "readFields": ["schemaVersion", "processId", "definitionId", "state", "pageSize", "cursor"],
    "writeCommonRequired": ["schemaVersion", "eventId", "producerId", "sourceExecutionId", "operation", "occurredAtUtc"],
    "intake": {
      "api": "rfd_RecordEmailProcessEvent",
      "eventType": "received",
      "requiredAdditional": ["definitionId"],
      "strongIdentity": "internetMessageId (exact case/brackets; trim only outer whitespace)",
      "weakIdentity": "When internetMessageId missing, sourceLocator is required; weak/reconciliation flags are server set",
      "optional": ["processId", "internetMessageId", "sourceLocator", "actualFrom", "replyTo", "emailId", "parentProcessId", "batchId", "draftId", "workflowId", "holdingId"],
      "forbidden": ["stageExecutionId", "parentExecutionId", "stageCode", "caseId", "contactId"]
    },
    "execution": {
      "api": "rfd_RecordEmailProcessEvent",
      "requiredAdditional": ["processId", "stageExecutionId", "stageCode", "attempt", "eventType"],
      "eventTypes": ["started", "waiting", "completed", "failed", "skipped", "cancelled"],
      "optional": ["branch", "sourceVersion", "outcome", "errorCode", "durationMs", "usage", "parentExecutionId", "caseId", "contactId", "emailId", "taskId", "noteId", "holdingId", "workflowId"],
      "attempt": "Positive native source-attempt integer scoped to producer/run/operation/stage/branch/case; new native runs may start at 1. Preserve on transport retries. Stored/read stage attempt is a separately allocated server-owned first-seen ordinal under process RowVersion concurrency.",
      "sourceVersion": "Nonnegative numeric string, not a JSON number",
      "outcome": "If present matches event; completed maps to succeeded and started maps to running",
      "stageAuthority": "Stage must exist in immutable definition and producer stageCodes; successful outcome requires exact completionAuthority",
      "workflowAttemptStages": "case-workflow-progress/case-closure-attempt require explicit workflow-authority definition rows and producer policy entries; not hardcoded or implicitly trusted",
      "contactResolution": "Only a completed identify-phase tool-authority execution in producer.customerResolutionStageCodes with producer.canResolveCustomer=true may bind contactId once or confirm the same ID; unreadable Contact, other stage, mismatched/rebound ID and header-only inference are rejected"
    },
    "caseLink": {
      "api": "rfd_LinkEmailProcessCase",
      "requiredAdditional": ["processId", "caseId", "relationshipRole"],
      "optional": ["blocksCompletion"],
      "blocksCompletionDefault": true,
      "caseClaimsAllowed": false,
      "relationshipValidation": "Actual incident.customerid equals established process Contact"
    },
    "caseLifecycleExternalReconciliation": {
      "api": "rfd_RecordCaseLifecycle",
      "required": ["schemaVersion", "processId", "caseId", "producerId", "occurredAtUtc"],
      "serverDerived": ["eventId", "sourceExecutionId", "operation", "eventType", "sourceVersion", "caseState", "caseStatus", "merged"],
      "historicalClaimsAllowed": false
    },
    "caseLifecycleTrustedObserver": {
      "api": "rfd_RecordCaseLifecycle",
      "required": ["schemaVersion", "processId", "caseId", "occurredAtUtc", "caseState", "caseStatus", "previousCaseState", "previousCaseStatus", "merged", "sourceVersion"],
      "serverValidation": "Exact registered async incident Update parent pre/post image/version/time required; not a publicly assertable producer role"
    },
    "identityAliasesNotAccepted": ["SpanId", "RunId", "isBlocking", "customerEmailCorrelation"],
    "unknownPropertiesRejected": true
  },
  "responseExamplesAreIllustrativeOnly": true,
