        "EP_Intake": [
          "Succeeded"
        ]
      },
      "metadata": {
        "rfdEmailProcessAdapter": {
          "version": 1,
          "sourceDefinitionSha256": "5f8fb98c8ec94eaf1585ce3244f26135f0205e03f7670e0e77ff395af654c07c",
          "profileSha256": "b2e069d267b125fde4742fc3a86edcfc665c11ea2d82e4bbe14bb41718cb9094"
