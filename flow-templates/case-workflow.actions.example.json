              "connectionName": "rfd_process_dataverse",
              "operationId": "PerformUnboundAction"
            },
            "parameters": {
              "actionName": "rfd_LinkEmailProcessCase",
              "item/RequestJson": "@string(outputs('EP_Link_case_Payload'))"
            },
